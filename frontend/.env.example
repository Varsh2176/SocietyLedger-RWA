# SocietyLedger Frontend Environment Configuration
# Local development uses the local API. A value with or without a trailing /api is accepted.
# On the single Vercel project, set VITE_API_BASE_URL=/api so previews stay on the same origin.
# A split deployment must use the API origin, for example https://api.example.com.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME="SocietyLedger"
# Development-only sample data when the API is unreachable. Production must be false.
VITE_ENABLE_MOCK_FALLBACK=false
