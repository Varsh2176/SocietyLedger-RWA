# SocietyLedger Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string. Local development uses the address below.
# Production must set MONGODB_URI in the host dashboard, not in this file.
# Use an Atlas SRV URI whose path is the database name, for example /society_ledger.
MONGODB_URI=mongodb://127.0.0.1:27017/society_ledger

# Optional absolute directory for private uploads in local development and Render.
# Production on Vercel ignores this directory and uses a private Blob store.
# On Render with the Blueprint disk, set UPLOADS_DIR=/var/data/uploads.
# UPLOADS_DIR=

# Private Vercel Blob store. Production requires one of these names.
# Create the store with private access. Do not put a real token in this file.
# Vercel injects BLOB_STORE_ID when the store is connected to the project.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=replace-with-the-private-blob-token

# Authentication Secrets
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=1d
COOKIE_SECRET=replace-with-a-long-random-cookie-secret

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Production initialization. Do not put real passwords in this file.
# The bootstrap command refuses to write unless BOOTSTRAP_CONFIRM is set.
# Atlas also requires NODE_ENV=production and CONFIRM_ATLAS_INIT=YES.
# BOOTSTRAP_CONFIRM=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# CONFIRM_ATLAS_INIT=
